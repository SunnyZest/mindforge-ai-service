# 复制这个文件为 .env，然后填真实值
#   PowerShell:  Copy-Item .env.example .env
#
# ⚠️ .env 已在 .gitignore 里，不会被提交。密钥只留在你本机。

# ---------- Java 后端 ----------
# 注意带 context-path：Java 侧 server.servlet.context-path=/api
JAVA_BASE_URL=http://localhost:8080/api

# 必须和 Java 的 application-dev.yml 里 mindforge.internal.service-token 完全一致
# 包括大小写、末尾的 = 、以及不能有首尾空格
JAVA_SERVICE_TOKEN=

# ---------- DashScope（LLM + 嵌入模型）----------
# 可以从 D:\pythoncode\agent\config\agent_config.yml 里复制过来
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-v1

# ---------- 轮询 ----------
# 没任务时的休眠秒数。别设太小，会把 Java 的日志刷爆
POLL_INTERVAL_SECONDS=5
# 单次认领的文档数上限
CLAIM_LIMIT=10
# 调试时可设 false，关掉自动轮询，改用 /health/java 手动探测
ENABLE_POLLER=true
# 每隔多少轮清理一次「已删除文档的向量」（轮询间隔 × 这个值 = 清理周期）
VECTOR_PURGE_EVERY_N_ROUNDS=12

# ---------- 分块 ----------
# 800/150 是文档里建议的值；原 agent 项目用的 200/20 偏碎，检索时上下文不够
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------- 抽取类场景（简历解析 / 邀约抽取）----------
# 是否让模型先「思考」再输出。默认 false。
# qwen3 系列默认开思考，思考 token 计入 completion_tokens 但不出现在返回内容里：
# 同一份简历 164 秒 → 41 秒，邀约抽取从「跑满 60 秒超时失败」变成 6.5 秒，字段没变少。
# 换到不支持 enable_thinking 参数的模型时设成 true 回退。
EXTRACT_ENABLE_THINKING=false

# ---------- 本服务 ----------
SERVICE_PORT=8000
