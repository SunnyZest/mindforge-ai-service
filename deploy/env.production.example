# ==============================================================================
# MindForge Python 服务生产 .env 模板
#
# 用法（服务器上）：
#   cp deploy/env.production.example /opt/mindforge/ai-service/.env
#   然后把 <...> 占位填成真实值，chmod 600 /opt/mindforge/ai-service/.env
#
# ⚠️ 不要提交真实值。
# ==============================================================================

# ---------- Java 后端 ----------
# 带上 context-path：Java 侧 server.servlet.context-path=/api
# 同机部署走回环地址，令牌永不出公网
JAVA_BASE_URL=http://127.0.0.1:8080/api

# 必须与 Java 生产配置 /opt/mindforge/mindforge.env 的 MINDFORGE_SERVICE_TOKEN 完全一致
JAVA_SERVICE_TOKEN=<与 Java 侧相同的新令牌>

# ---------- DashScope（LLM + 嵌入模型）----------
DASHSCOPE_API_KEY=<sk-...>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-27b
EMBEDDING_MODEL=text-embedding-v1

# ---------- 轮询（Python 认领 Java 的文档解析任务）----------
POLL_INTERVAL_SECONDS=5
CLAIM_LIMIT=10
ENABLE_POLLER=true

# ---------- 分块 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------- 本服务 ----------
# systemd unit 已固定 127.0.0.1:8000，这里保持一致即可
SERVICE_PORT=8000
